# Copy to frontend/.env.local and fill in for local development. Never commit the real file.
# On Vercel, set these as server-side Production environment variables.
# Root directory: frontend; Vercel runs the existing npm build script.

# Direct `npm run dev` uses port 3000. Docker Compose overrides this with the
# host-facing URL http://localhost:3001 so OAuth returns to the published port.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register https://<production-host>/api/auth/callback/google with Google OAuth.

# Server-only. MUST match backend/.env INTERNAL_API_KEY exactly.
# Never add a NEXT_PUBLIC_ prefix to this: that inlines it into the browser
# bundle and hands the backend's shared secret to every visitor.
INTERNAL_API_KEY=

# Server-only API origin. On Vercel use the Railway API's public HTTPS origin;
# Vercel cannot reach Railway's private service network. Compose overrides this.
INTERNAL_API_URL=http://127.0.0.1:8001
AUTH_TRUST_HOST=true
