# Copy to frontend/.env.local and fill in. Never commit the real file.

# Direct `npm run dev` uses port 3000. Docker Compose overrides this with the
# host-facing URL http://localhost:3001 so OAuth returns to the published port.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only. MUST match backend/.env INTERNAL_API_KEY exactly.
# Never add a NEXT_PUBLIC_ prefix to this: that inlines it into the browser
# bundle and hands the backend's shared secret to every visitor.
INTERNAL_API_KEY=

# Server-only API origin. Compose overrides to http://backend:8000.
INTERNAL_API_URL=http://127.0.0.1:8001
AUTH_TRUST_HOST=true
