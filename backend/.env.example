# Copy to backend/.env and fill in. Never commit the real file.

DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/neuro_db
FRONTEND_URL=http://localhost:3000

# REQUIRED. No default is provided: a default here fails open.
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be >= 32 chars. The app refuses to start on a weak or placeholder value.
SECRET_KEY=
# Must match frontend/.env.local INTERNAL_API_KEY exactly.
INTERNAL_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GROQ_API_KEY=
# Groq retires models without notice; check https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Gemini — https://aistudio.google.com/apikey
# Verify configured model eligibility against official documentation/account.
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Unvalidated V1 operational default; bounds one Gemini generation request.
GEMINI_GENERATION_TIMEOUT_SECONDS_V1=45
CONCEPT_EXTRACTION_MAX_GENERATION_ATTEMPTS_V1=2

# Celery / Redis: Redis locally, Upstash-compatible TLS URL in production.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Unvalidated V1 defaults; benchmark representative fixtures before changing.
INDEXING_BATCH_SIZE_V1=10
INDEXING_WORKER_CONCURRENCY_V1=2

# Private Supabase S3-compatible Storage. Keep the bucket private.
STORAGE_BUCKET=neurolearn-sources
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS_V1=900

# Unvalidated operational defaults. Lease must exceed heartbeat and provider timeout.
JOB_HEARTBEAT_SECONDS_V1=15
JOB_LEASE_SECONDS_V1=120
# Evaluator-only endpoints default inaccessible; verified account emails only.
EVALUATOR_EMAILS=
# Local originals remain private and outside Git.
DOCUMENT_STORAGE_ROOT=var/uploads
